# ---------- core ----------
ADDR=:8080
DATABASE_URL=postgres://dropdat:dropdat@localhost:5432/dropdat?sslmode=disable
CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000

# Local development bypass — never set in prod.
# DEV_AUTH_BYPASS=1
# DEV_USER_ID=user_dev

# ---------- Clerk auth ----------
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_SECRET_KEY=

# ---------- Embeddings (OpenAI) ----------
# If unset, capsule embedding silently no-ops; recall/graph endpoints still
# work but quality drops to keyword-only.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Backfill knobs (used by cmd/embed-backfill).
# EMBED_FORCE=1            # re-embed even if a vector already exists
# EMBED_RPM=120            # cap requests-per-minute for free-tier providers
# BATCH=50                 # rows processed per loop iteration

# ---------- Dodopayments (billing) ----------
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test    # "test" or "live"
DODO_WEBHOOK_SECRET=

DODO_PRO_MONTHLY_PRODUCT_ID=
DODO_PRO_ANNUAL_PRODUCT_ID=
DODO_PREMIUM_MONTHLY_PRODUCT_ID=
DODO_PREMIUM_ANNUAL_PRODUCT_ID=
DODO_ULTIMATE_MONTHLY_PRODUCT_ID=
DODO_ULTIMATE_ANNUAL_PRODUCT_ID=

# ---------- Cloudflare R2 (capsule attachments) ----------
# All four required. If any are missing, attachments storage is disabled and
# the upload endpoints return 503 — the rest of the app keeps working.
# Endpoint URL is derived as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dropdat-attachments

# ---------- Admin ----------
# Comma-separated Clerk user ids that can access /admin (api: /api/v1/admin/*).
# Anything not in this list is denied. Leave empty to disable the dashboard.
ADMIN_USER_IDS=

# Bucket CORS (set once via wrangler or dashboard):
#   AllowedOrigins: https://dropdat.app, http://localhost:3000
#   AllowedMethods: PUT, GET
#   AllowedHeaders: *
#   MaxAgeSeconds: 3600
