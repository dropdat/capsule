# Public domain (Caddy uses for auto-TLS)
DOMAIN=dropdat.app
ACME_EMAIL=support@dropdat.app

# Postgres
POSTGRES_USER=dropdat
POSTGRES_PASSWORD=changeme
POSTGRES_DB=dropdat
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# CORS — comma-separated origins allowed to call /api/*
CORS_ORIGINS=https://dropdat.app,https://www.dropdat.app,https://capsule.dropdat.app,http://localhost:3000

# Clerk (production)
CLERK_JWKS_URL=https://clerk.dropdat.app/.well-known/jwks.json
CLERK_ISSUER=https://clerk.dropdat.app
CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Local dev escape hatch — leave blank in prod
DEV_AUTH_BYPASS=
DEV_USER_ID=

# Embeddings — optional, drives semantic capsule search.
# Without OPENAI_API_KEY, /capsules/search degrades to BM25-only.
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Billing (dodopayments)
# API key + environment for the REST client; webhook secret for HMAC verify.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_WEBHOOK_SECRET=
# Return URL for the hosted checkout (where dodopayments redirects after pay).
APP_URL=https://capsule.dropdat.app
# Product ids per (plan, interval). Annual ids optional — leave blank to disable annual.
DODO_PRO_MONTHLY_PRODUCT_ID=
DODO_PRO_ANNUAL_PRODUCT_ID=
DODO_PREMIUM_MONTHLY_PRODUCT_ID=
DODO_PREMIUM_ANNUAL_PRODUCT_ID=
DODO_ULTIMATE_MONTHLY_PRODUCT_ID=
DODO_ULTIMATE_ANNUAL_PRODUCT_ID=

# Cloudflare R2 — backs capsule attachments. All four required; if any is
# missing, attachments stay disabled (upload endpoints return 503) but the
# rest of the API keeps working. Endpoint is derived from R2_ACCOUNT_ID.
# Bucket CORS must allow PUT+GET from your CORS_ORIGINS for browser-direct uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dropdat-attachments
