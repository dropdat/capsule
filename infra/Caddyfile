{
  email {$ACME_EMAIL:admin@dropdat.app}
}

{$DOMAIN:dropdat.app}, www.{$DOMAIN:dropdat.app} {
  encode gzip zstd

  # Go API
  handle /api/* {
    reverse_proxy api:8080
  }

  # Next.js metadata routes (opengraph-image, twitter-image) export as
  # extension-less binary files; force the correct MIME so social cards work.
  @ogImage path /opengraph-image /twitter-image
  header @ogImage Content-Type "image/png"

  # Static marketing site (Next.js export). The /dashboard route still lives
  # in the build, but production traffic to it is served via capsule.dropdat.app.
  handle {
    root * /var/www/dropdat
    try_files {path} {path}/index.html
    file_server
  }

  log {
    output stdout
    format console
  }
}

# DMT backend shares this EC2. Its api+postgres run from /opt/dmt and the
# dmt-api container joins this Caddy's docker network, so we can reach it by
# container name. DNS: dmt.dropdat.app A record -> this server's IP.
dmt.{$DOMAIN:dropdat.app} {
  encode gzip zstd
  reverse_proxy dmt-api:8000

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    -Server
  }

  log {
    output stdout
    format console
  }
}

capsule.{$DOMAIN:dropdat.app} {
  encode gzip zstd

  # Go API also reachable from the dashboard subdomain
  handle /api/* {
    reverse_proxy api:8080
  }

  # Dashboard pages live at /library, /api-keys, /settings, /capsule
  # in the static export. Bare "/" lands on the library.
  handle {
    root * /var/www/dropdat

    @root path /
    rewrite @root /library/

    try_files {path} {path}index.html
    file_server
  }

  log {
    output stdout
    format console
  }
}
