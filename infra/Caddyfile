{
  email {$ACME_EMAIL:admin@dropdat.app}
}

{$DOMAIN:dropdat.app}, www.{$DOMAIN:dropdat.app} {
  encode gzip zstd

  # Go API
  handle /api/* {
    reverse_proxy api:8080
  }

  # Static marketing site (Next.js export). The /dashboard route still lives
  # in the build, but production traffic to it is served via capsule.dropdat.app.
  handle {
    root * /var/www/dropdat
    try_files {path} {path}/index.html
    file_server
  }

  log {
    output stdout
    format console
  }
}

capsule.{$DOMAIN:dropdat.app} {
  encode gzip zstd

  # Go API also reachable from the dashboard subdomain
  handle /api/* {
    reverse_proxy api:8080
  }

  # Mount the exported /dashboard tree at the subdomain root.
  # Static assets (/_next/*, fonts, brand) resolve directly; bare routes
  # fall back to the /dashboard/* tree.
  handle {
    root * /var/www/dropdat

    # Bare "/" should land on the dashboard index, not the marketing index.
    @root path /
    rewrite @root /dashboard/

    try_files {path} {path}index.html /dashboard{path} /dashboard{path}index.html
    file_server
  }

  log {
    output stdout
    format console
  }
}
